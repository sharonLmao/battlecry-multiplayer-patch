      override public function GetAnimationAssetGroup(a:AnimationAsset) : int
      {
         if(Utils.IsInstanceOfClass(a,ASSET_WEAPONS))
         {
            return UnitView.ASSET_WEAPON;
         }
         if(Utils.IsInstanceOfClass(a,ASSET_SHIELDS))
         {
            return UnitView.ASSET_SHIELD;
         }
         if(Utils.IsInstanceOfClass(a,ASSET_SKINS))
         {
            return UnitView.ASSET_SKIN;
         }
         if(Utils.IsInstanceOfClass(a,ASSET_ARMOR))
         {
            return UnitView.ASSET_ARMOR;
         }
         if(Utils.IsInstanceOfClass(a,ASSET_HORSE))
         {
            return UnitView.ASSET_HORSE;
         }
         if(Utils.IsInstanceOfClass(a,ASSET_ANIMAL))
         {
            return UnitView.ASSET_ANIMAL;
         }
         return super.GetAnimationAssetGroup(a);
      }
