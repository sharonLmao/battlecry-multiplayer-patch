      public static function GetFromId(id:int) : ModelCampaign
      {
         for(var i:int = 0; i < ALL.length; i++)
         {
            if(id == ALL[i].id)
            {
               return ALL[i];
            }
         }
         return null;
      }
      
      private static function CreateModelCampaign(id:int, storyArray:Array, tipTxtID:int, endStoryTxtID:int, campaignIcon:int, campaignName:int, campaignStage:int, goldReward:int, boosterPackID:int, act:int, chapter:ModelChapter, itemReward:Vector.<MetaEquipement>, metaArmy:BC_MetaArmy, backgroundID:int) : ModelCampaign
      {
         var m:ModelCampaign = new ModelCampaign(id,storyArray,tipTxtID,endStoryTxtID,campaignIcon,campaignName,campaignStage,goldReward,boosterPackID,act,chapter,itemReward,metaArmy,backgroundID);
         ALL.push(m);
         switch(chapter.id)
         {
            case ModelChapterEnum.CHAPTER1.id:
               switch(act)
               {
                  case ModelCampaign.ACT1:
                     ACT_1_1.push(m);
                     break;
                  case ModelCampaign.ACT2:
                     ACT_1_2.push(m);
                     break;
                  case ModelCampaign.ACT3:
                     ACT_1_3.push(m);
               }
               break;
            case ModelChapterEnum.CHAPTER2.id:
               switch(act)
               {
                  case ModelCampaign.ACT1:
                     ACT_2_1.push(m);
                     break;
                  case ModelCampaign.ACT2:
                     ACT_2_2.push(m);
                     break;
                  case ModelCampaign.ACT3:
                     ACT_2_3.push(m);
               }
               break;
            case ModelChapterEnum.CHAPTER3.id:
               switch(act)
               {
                  case ModelCampaign.ACT1:
                     ACT_3_1.push(m);
                     break;
                  case ModelCampaign.ACT2:
                     ACT_3_2.push(m);
                     break;
                  case ModelCampaign.ACT3:
                     ACT_3_3.push(m);
               }
         }
         return m;
      }
